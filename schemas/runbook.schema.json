{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-ai-runbooks.dev/schemas/runbook.schema.json",
  "title": "AI Agent Runbook Metadata",
  "description": "Schema for the YAML front matter of every runbook in awesome-ai-runbooks.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "title",
    "category",
    "maturity",
    "risk_level",
    "estimated_duration",
    "supported_agents",
    "required_access",
    "human_in_the_loop",
    "owner",
    "version",
    "last_reviewed",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Kebab-case identifier; must match the filename stem."
    },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "category": {
      "type": "string",
      "enum": [
        "reliability",
        "observability",
        "databases",
        "messaging",
        "security",
        "kubernetes",
        "cloud-cost",
        "migrations",
        "architecture",
        "cicd",
        "ai-ml",
        "data",
        "soc"
      ]
    },
    "domain": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "difficulty": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced", "expert"]
    },
    "estimated_duration": {
      "type": "string",
      "description": "Duration or range using units m (min), h (hour), d (day), w (week), mo (month), y (year).",
      "pattern": "^[0-9]+(m|h|d|w|mo|y)([-][0-9]+(m|h|d|w|mo|y))?$"
    },
    "platform": { "type": "string" },
    "agent_type": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supported_agents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "devin",
          "claude-code",
          "github-copilot-agent",
          "openai-codex",
          "cursor",
          "openhands",
          "autogen",
          "crewai",
          "langgraph",
          "mcp-agent"
        ]
      }
    },
    "required_access": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_tools": {
      "type": "array",
      "items": { "type": "string" }
    },
    "human_in_the_loop": {
      "type": "string",
      "enum": ["required", "recommended", "optional"]
    },
    "author": { "type": "string" },
    "owner": { "type": "string" },
    "reviewers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "maturity": {
      "type": "string",
      "enum": ["draft", "validated", "reviewed", "production", "stable", "enterprise", "reference", "reference-standard"]
    },
    "maturity_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "status": {
      "type": "string",
      "enum": ["draft", "in-review", "approved", "deprecated", "archived"]
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "compliance_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "examples": ["soc2", "iso27001", "nist-ai-rmf", "pci-dss", "owasp-top-10", "owasp-api-top-10", "owasp-llm-top-10", "cis"]
      }
    }
  }
}
